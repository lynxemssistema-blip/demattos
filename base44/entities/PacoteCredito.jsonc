{
  "name": "PacoteCredito",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do pacote (ex: Pacote B\u00e1sico)"
    },
    "quantidade_tokens": {
      "type": "number",
      "description": "Quantidade de cr\u00e9ditos/tokens no pacote"
    },
    "preco_reais": {
      "type": "number",
      "description": "Pre\u00e7o do pacote em reais"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "ID do pre\u00e7o no Stripe (price_...)"
    },
    "desconto_percentual": {
      "type": "number",
      "default": 0,
      "description": "Desconto percentual em rela\u00e7\u00e3o ao pacote base"
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Se o pacote deve ser destacado"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o pacote est\u00e1 ativo para compra"
    }
  },
  "required": [
    "nome",
    "quantidade_tokens",
    "preco_reais"
  ]
}