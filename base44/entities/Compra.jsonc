{
  "name": "Compra",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto comprado"
    },
    "produto_nome": {
      "type": "string",
      "description": "Nome do produto"
    },
    "produto_tipo": {
      "type": "string",
      "enum": [
        "fisico",
        "digital"
      ],
      "description": "Tipo do produto"
    },
    "produto_arquivo_pdf_url": {
      "type": "string",
      "description": "URL do PDF (se produto digital)"
    },
    "valor": {
      "type": "number",
      "description": "Valor pago"
    },
    "status_pagamento": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmado",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status do pagamento via Stripe"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "ID do payment intent do Stripe"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "ID da sess\u00e3o de checkout do Stripe"
    }
  },
  "required": [
    "cliente_email",
    "produto_id",
    "produto_nome",
    "produto_tipo",
    "valor"
  ]
}