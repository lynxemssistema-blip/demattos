{
  "name": "Depoimento",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cliente_profissao": {
      "type": "string",
      "description": "Profiss\u00e3o do cliente"
    },
    "cliente_foto_url": {
      "type": "string",
      "description": "Foto do cliente"
    },
    "texto": {
      "type": "string",
      "description": "Texto do depoimento"
    },
    "avaliacao": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Avalia\u00e7\u00e3o de 1 a 5 estrelas"
    },
    "enviado_para_aprovacao": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente enviou para aprova\u00e7\u00e3o"
    },
    "aprovado": {
      "type": "boolean",
      "default": false,
      "description": "Se o admin aprovou para exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "cliente_id",
    "texto",
    "avaliacao"
  ]
}