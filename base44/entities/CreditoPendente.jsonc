{
  "name": "CreditoPendente",
  "type": "object",
  "properties": {
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que receber\u00e1 os cr\u00e9ditos"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade de cr\u00e9ditos pendentes"
    },
    "admin_que_concedeu": {
      "type": "string",
      "description": "Email do admin que concedeu"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre a concess\u00e3o"
    },
    "aplicado": {
      "type": "boolean",
      "default": false,
      "description": "Se os cr\u00e9ditos j\u00e1 foram aplicados ao usu\u00e1rio"
    }
  },
  "required": [
    "usuario_email",
    "quantidade",
    "admin_que_concedeu"
  ]
}