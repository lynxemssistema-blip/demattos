{
  "name": "Combo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do combo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do combo"
    },
    "produtos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos produtos que comp\u00f5em o combo"
    },
    "preco": {
      "type": "number",
      "description": "Pre\u00e7o do combo (pode ser menor que a soma dos produtos)"
    },
    "imagem_url": {
      "type": "string",
      "description": "URL da imagem do combo"
    },
    "instagram_url": {
      "type": "string",
      "description": "Link do post/reels do Instagram para o combo"
    },
    "stripe_product_id": {
      "type": "string",
      "description": "ID do produto no Stripe"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "ID do pre\u00e7o no Stripe"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o combo est\u00e1 ativo"
    }
  },
  "required": [
    "nome",
    "preco",
    "produtos_ids"
  ]
}