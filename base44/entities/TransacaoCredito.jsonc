{
  "name": "TransacaoCredito",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "compra",
        "bonus_admin",
        "consumo_ia",
        "estorno"
      ],
      "description": "Tipo da transa\u00e7\u00e3o"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade de cr\u00e9ditos (positivo para adi\u00e7\u00e3o, negativo para consumo)"
    },
    "valor_pago": {
      "type": "number",
      "description": "Valor pago em reais (se aplic\u00e1vel)"
    },
    "pacote_id": {
      "type": "string",
      "description": "ID do pacote comprado (se aplic\u00e1vel)"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "ID do payment intent do Stripe"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "ID da sess\u00e3o de checkout do Stripe"
    },
    "admin_que_concedeu": {
      "type": "string",
      "description": "Email do admin que concedeu cr\u00e9ditos (para tipo bonus_admin)"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre a transa\u00e7\u00e3o"
    }
  },
  "required": [
    "usuario_id",
    "usuario_email",
    "tipo",
    "quantidade"
  ]
}