{
  "name": "Servico",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do servi\u00e7o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o"
    },
    "preco": {
      "type": "number",
      "description": "Pre\u00e7o do servi\u00e7o"
    },
    "duracao": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "icone": {
      "type": "string",
      "enum": [
        "Scissors",
        "Sparkles",
        "Droplets",
        "Crown"
      ],
      "default": "Scissors",
      "description": "\u00cdcone do servi\u00e7o"
    },
    "destaque_home": {
      "type": "boolean",
      "default": false,
      "description": "Se o servi\u00e7o aparece na p\u00e1gina inicial"
    },
    "exibir_no_catalogo": {
      "type": "boolean",
      "default": false,
      "description": "Se o servi\u00e7o aparece na p\u00e1gina de cat\u00e1logo p\u00fablico"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o servi\u00e7o est\u00e1 ativo"
    }
  },
  "required": [
    "nome",
    "preco",
    "duracao"
  ]
}